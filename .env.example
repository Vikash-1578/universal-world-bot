# Copy this file to .env and fill it in. Never share or commit .env.
# Telegram bot token from @BotFather -> /mybots -> API Token
BOT_TOKEN=
# Your own numeric Telegram id. Leave empty, start the bot, send it a message: it will tell you your id.
OWNER_ID=
# Optional tool locations (auto-detected if empty)
FFMPEG_PATH=
BLENDER_PATH=
LOG_LEVEL=INFO
